generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SkillName {
  LISTENING
  READING
  WRITING
  SPEAKING
}

enum TestType {
  PLACEMENT
  FULL_LEVEL
  CHECKPOINT
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  SCORED
  ABANDONED
}

enum ScoringStatus {
  NOT_STARTED
  SCORING
  SCORED
  FAILED
}

enum UnlockSource {
  PLACEMENT
  TEST_PASS
  ADMIN
}

enum TutorRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ContentRefType {
  LESSON
  PASSAGE
  AUDIO_SCRIPT
}

enum WritingTaskType {
  TASK1_ACADEMIC
  TASK1_GENERAL
  TASK2
}

enum SpeakingSessionType {
  PART_PRACTICE
  FULL_SIM
  PLACEMENT
  FULL_TEST
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  accounts    Account[]
  sessions    Session[]
  profile          Profile?
  attempts         TestAttempt[]
  progress         Progress[]
  aiFeedback       AIFeedback[]
  subscription     Subscription?
  placementResult  PlacementResult?
  lessonCompletions LessonCompletion[]
  tutorConversations TutorConversation[]
  writingSubmissions WritingSubmission[]
  speakingSessions   SpeakingSession[]
  levelUnlocks       LevelUnlock[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  displayName        String?
  nativeLanguage     String    @default("vi")
  targetBand         Float?
  currentLevel       Int       @default(1)
  placementCompleted Boolean   @default(false)
  weakSkills         SkillName[]
  graduatedAt        DateTime?
  bestFullTestBand   Float?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Level {
  id           String   @id @default(cuid())
  number       Int      @unique
  title        String
  titleVi      String
  descriptionVi String?

  lessons  Lesson[]
  tests    Test[]
  progress Progress[]
  unlocks  LevelUnlock[]
}

model Skill {
  id   String    @id @default(cuid())
  name SkillName @unique

  lessons    Lesson[]
  sections   TestSection[]
  progress   Progress[]
  aiFeedback AIFeedback[]
}

model Lesson {
  id            String    @id @default(cuid())
  levelId       String
  skillId       String
  title         String
  titleVi       String
  order         Int
  contentJson   Json?
  publishedAt   DateTime?
  isCheckpoint  Boolean   @default(false)
  estimatedMin  Int       @default(15)

  level       Level              @relation(fields: [levelId], references: [id], onDelete: Cascade)
  skill       Skill              @relation(fields: [skillId], references: [id], onDelete: Cascade)
  exercises   Exercise[]
  completions LessonCompletion[]
  conversations TutorConversation[]

  @@unique([levelId, skillId, order])
}

model Exercise {
  id         String @id @default(cuid())
  lessonId   String
  type       String
  promptJson Json
  answerJson Json?
  order      Int

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, order])
}

model Test {
  id               String    @id @default(cuid())
  levelId          String?
  type             TestType
  title            String
  durationMin      Int
  publishedAt      DateTime?
  /// { minOverallBand: number, minSkillBand: number }
  passingRulesJson Json?

  level    Level?         @relation(fields: [levelId], references: [id], onDelete: SetNull)
  sections TestSection[]
  attempts TestAttempt[]

  @@unique([levelId, type])
}

model TestSection {
  id             String @id @default(cuid())
  testId         String
  skillId        String
  order          Int
  durationMin    Int
  instructionsVi String?
  metadataJson   Json?

  test      Test                  @relation(fields: [testId], references: [id], onDelete: Cascade)
  skill     Skill                 @relation(fields: [skillId], references: [id], onDelete: Cascade)
  questions Question[]
  progress  TestSectionProgress[]

  @@unique([testId, order])
}

model Question {
  id                String @id @default(cuid())
  sectionId         String
  type              String
  contentJson       Json
  correctAnswerJson Json?
  points            Float  @default(1)
  order             Int

  section TestSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@unique([sectionId, order])
}

model TestAttempt {
  id              String         @id @default(cuid())
  userId          String
  testId          String
  startedAt       DateTime       @default(now())
  submittedAt     DateTime?
  status          AttemptStatus  @default(IN_PROGRESS)
  scoringStatus   ScoringStatus  @default(NOT_STARTED)
  scoringError    String?
  scoringRetries  Int            @default(0)
  passed          Boolean?
  unlockGranted   Boolean        @default(false)
  cooldownUntil   DateTime?
  overallBand     Float?
  rawScoreJson    Json?

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  test            Test                  @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers         Answer[]
  feedback        AIFeedback[]
  placementResult PlacementResult?
  sectionProgress TestSectionProgress[]
}

model LevelUnlock {
  id         String       @id @default(cuid())
  userId     String
  levelId    String
  unlockedAt DateTime     @default(now())
  unlockedBy UnlockSource

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  level Level @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
}

model TestSectionProgress {
  id           String    @id @default(cuid())
  attemptId    String
  sectionId    String
  startedAt    DateTime?
  submittedAt  DateTime?
  timeSpentSec Int?

  attempt TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  section TestSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, sectionId])
}

model Answer {
  id               String  @id @default(cuid())
  attemptId        String
  questionId       String
  userResponseJson Json
  isCorrect        Boolean?
  awardedPoints    Float?

  attempt  TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model AIFeedback {
  id           String     @id @default(cuid())
  attemptId    String?
  userId       String
  skillId      String?
  kind         String
  model        String
  promptHash   String
  responseJson Json
  createdAt    DateTime   @default(now())

  attempt TestAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill?       @relation(fields: [skillId], references: [id], onDelete: SetNull)
}

model Progress {
  id                String   @id @default(cuid())
  userId            String
  levelId           String
  skillId           String
  lessonsCompleted  Int      @default(0)
  checkpointPassed  Boolean  @default(false)
  lastActivityAt    DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  level Level @relation(fields: [levelId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId, skillId])
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  stripeCustomerId String?
  stripeSubId      String?
  status           String    @default("inactive")
  currentPeriodEnd DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlacementResult {
  id               String   @id @default(cuid())
  userId           String   @unique
  attemptId        String   @unique
  listeningBand    Float
  readingBand      Float
  writingBand      Float
  speakingBand     Float
  overallBand      Float
  recommendedLevel Int
  strengthsJson    Json
  weaknessesJson   Json
  summaryVi        String   @db.Text
  createdAt        DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model LessonCompletion {
  id               String   @id @default(cuid())
  userId           String
  lessonId         String
  completedAt      DateTime @default(now())
  score            Float
  checkpointPassed Boolean  @default(false)
  attemptsJson     Json?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model TutorConversation {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson   Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  messages TutorMessage[]
}

model TutorMessage {
  id             String    @id @default(cuid())
  conversationId String
  role           TutorRole
  content        String    @db.Text
  tokens         Int?
  createdAt      DateTime  @default(now())

  conversation TutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model ContentEmbedding {
  id        String         @id @default(cuid())
  refType   ContentRefType
  refId     String
  embedding Float[]
  createdAt DateTime       @default(now())

  @@index([refType, refId])
}

model WritingPrompt {
  id             String          @id @default(cuid())
  taskType       WritingTaskType
  levelBucket    String
  levelMin       Int
  levelMax       Int
  title          String
  titleVi        String
  prompt         String          @db.Text
  promptImageUrl String?
  publishedAt    DateTime?       @default(now())
  createdAt      DateTime        @default(now())

  modelAnswers WritingModelAnswer[]
}

model WritingModelAnswer {
  id        String   @id @default(cuid())
  promptId  String
  band6Json Json
  band75Json Json
  band9Json Json
  createdAt DateTime @default(now())

  prompt WritingPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId])
}

model WritingSubmission {
  id             String          @id @default(cuid())
  userId         String
  taskType       WritingTaskType
  level          Int
  promptId       String?
  prompt         String          @db.Text
  promptImageUrl String?
  essayText      String          @db.Text
  wordCount      Int
  timeSpentSec   Int             @default(0)
  attemptId      String?
  createdAt      DateTime        @default(now())

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluation  WritingEvaluation?
}

model WritingEvaluation {
  id              String   @id @default(cuid())
  submissionId    String   @unique
  overallBand     Float
  criteriaJson    Json
  correctionsJson Json
  nextStepsJson   Json
  strengthsJson   Json?
  modelBand6      String?  @db.Text
  modelBand75     String?  @db.Text
  modelBand9      String?  @db.Text
  modelNotesJson  Json?
  createdAt       DateTime @default(now())

  submission WritingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model WritingTemplate {
  id               String          @id @default(cuid())
  taskType         WritingTaskType
  band             Int
  title            String
  titleVi          String
  structureJson    Json
  samplePhrasesJson Json
  createdAt        DateTime        @default(now())
}

model SpeakingSession {
  id          String              @id @default(cuid())
  userId      String
  sessionType SpeakingSessionType
  level       Int
  part        Int?
  scriptJson  Json?
  startedAt   DateTime            @default(now())
  completedAt DateTime?
  attemptId   String?

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns       SpeakingTurn[]
  evaluation  SpeakingEvaluation?
}

model SpeakingTurn {
  id           String   @id @default(cuid())
  sessionId    String
  part         Int
  questionText String   @db.Text
  audioUrl     String?  @db.Text
  transcript   String   @db.Text
  wordTimestampsJson Json?
  durationSec  Float    @default(0)
  wpm          Float    @default(0)
  pauseCount   Int      @default(0)
  fillerCount  Int      @default(0)
  createdAt    DateTime @default(now())

  session SpeakingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SpeakingEvaluation {
  id              String   @id @default(cuid())
  sessionId       String   @unique
  overallBand     Float
  criteriaJson    Json
  correctionsJson Json
  nextStepsJson   Json
  strengthsJson   Json?
  drillsJson      Json?
  createdAt       DateTime @default(now())

  session SpeakingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
