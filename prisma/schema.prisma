generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SkillName {
  LISTENING
  READING
  WRITING
  SPEAKING
}

enum TestType {
  PLACEMENT
  FULL_LEVEL
  CHECKPOINT
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  SCORED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  accounts    Account[]
  sessions    Session[]
  profile     Profile?
  attempts    TestAttempt[]
  progress    Progress[]
  aiFeedback  AIFeedback[]
  subscription Subscription?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  displayName        String?
  nativeLanguage     String   @default("vi")
  targetBand         Float?
  currentLevel       Int      @default(1)
  placementCompleted Boolean  @default(false)
  weakSkills         SkillName[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Level {
  id           String   @id @default(cuid())
  number       Int      @unique
  title        String
  titleVi      String
  descriptionVi String?

  lessons  Lesson[]
  tests    Test[]
  progress Progress[]
}

model Skill {
  id   String    @id @default(cuid())
  name SkillName @unique

  lessons    Lesson[]
  sections   TestSection[]
  progress   Progress[]
  aiFeedback AIFeedback[]
}

model Lesson {
  id          String    @id @default(cuid())
  levelId     String
  skillId     String
  title       String
  titleVi     String
  order       Int
  contentJson Json?
  publishedAt DateTime?

  level     Level      @relation(fields: [levelId], references: [id], onDelete: Cascade)
  skill     Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  exercises Exercise[]

  @@unique([levelId, skillId, order])
}

model Exercise {
  id         String @id @default(cuid())
  lessonId   String
  type       String
  promptJson Json
  answerJson Json?
  order      Int

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, order])
}

model Test {
  id          String    @id @default(cuid())
  levelId     String?
  type        TestType
  title       String
  durationMin Int
  publishedAt DateTime?

  level    Level?         @relation(fields: [levelId], references: [id], onDelete: SetNull)
  sections TestSection[]
  attempts TestAttempt[]
}

model TestSection {
  id             String @id @default(cuid())
  testId         String
  skillId        String
  order          Int
  durationMin    Int
  instructionsVi String?

  test      Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  skill     Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([testId, order])
}

model Question {
  id                String @id @default(cuid())
  sectionId         String
  type              String
  contentJson       Json
  correctAnswerJson Json?
  points            Float  @default(1)
  order             Int

  section TestSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@unique([sectionId, order])
}

model TestAttempt {
  id           String        @id @default(cuid())
  userId       String
  testId       String
  startedAt    DateTime      @default(now())
  submittedAt  DateTime?
  status       AttemptStatus @default(IN_PROGRESS)
  overallBand  Float?
  rawScoreJson Json?

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  test     Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers  Answer[]
  feedback AIFeedback[]
}

model Answer {
  id               String  @id @default(cuid())
  attemptId        String
  questionId       String
  userResponseJson Json
  isCorrect        Boolean?
  awardedPoints    Float?

  attempt  TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model AIFeedback {
  id           String     @id @default(cuid())
  attemptId    String?
  userId       String
  skillId      String?
  kind         String
  model        String
  promptHash   String
  responseJson Json
  createdAt    DateTime   @default(now())

  attempt TestAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill?       @relation(fields: [skillId], references: [id], onDelete: SetNull)
}

model Progress {
  id                String   @id @default(cuid())
  userId            String
  levelId           String
  skillId           String
  lessonsCompleted  Int      @default(0)
  checkpointPassed  Boolean  @default(false)
  lastActivityAt    DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  level Level @relation(fields: [levelId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId, skillId])
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  stripeCustomerId String?
  stripeSubId      String?
  status           String    @default("inactive")
  currentPeriodEnd DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
